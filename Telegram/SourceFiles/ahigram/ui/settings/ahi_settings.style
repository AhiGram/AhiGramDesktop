using "ui/widgets/widgets.style";
using "info/info.style";

ahiSettingsButton: SettingsButton(infoProfileButton) {
	style: boxTextStyle;
	padding: margins(60px, 10px, 22px, 10px);
	iconLeft: 20px;
}

ahiSettingsButtonNoIcon: SettingsButton(ahiSettingsButton) {
	padding: margins(22px, 10px, 22px, 8px);
}

ahiMenuIconSettings: icon {{ "ahigram/menu_settings", menuIconColor }};
ahiInvisibleSettings: icon {{ "ahigram/invisible_settings", menuIconColor }};
